   "gn": "https://news.google.com/rss/articles/CBMib0FVX3lxTE1wVkliZk9kaTJULVlFTWZUSnZnQ1BrMFdwcDlVT0ZKTVNEOXYtMEFIb0JRU0NQdGo4YjJ4UlBBblZVRnJfNGVJeXhnS2NieW85eU5wb3JLRldCTWwxbE5FZkJpTFNjWW5zMUhBQkQ1bw?oc=5",
   "s": "Pause Hardware",
   "d": "2026-11-04T10:16:08+00:00",
